{
	"name": "apc-ups",
	"version": "2.0.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"format": "prettier -w .",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw .",
		"dist": "yarn companion-module-build",
		"package": "rimraf dist && yarn build:main && yarn dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-apc-ups.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"snmp-native": "^1.2.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^26.6.2",
		"@types/snmp-native": "^1.2.5",
		"@vitest/coverage-v8": "5.0.1",
		"eslint": "^10.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "5.0.1"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"engines": {
		"node": "^26.5",
		"yarn": "^4.0.0"
	},
	"packageManager": "yarn@4.18.0"
}
